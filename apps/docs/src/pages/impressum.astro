---
/**
 * Bilingual legal notice (Impressum, § 5 DDG). German is the authoritative
 * version; the English translation follows for convenience. Content is
 * mirrored in apps/marketing — keep both copies in sync until a shared
 * package exists.
 */
import Base from "../layouts/Base.astro";
---

<Base
  title="Impressum — Marginalia Docs"
  description="Impressum / legal notice for the Marginalia documentation site, pursuant to § 5 DDG."
>
  <article class="max-w-3xl">
    <p class="eyebrow">Rechtliches / Legal</p>
    <h1 class="font-display mt-3 text-4xl font-medium">Impressum</h1>

    <section lang="de">
      <h2 class="font-display mt-10 text-2xl font-medium">Angaben gemäß § 5 DDG</h2>
      <address class="mt-3 leading-relaxed not-italic">
        Sebastian Heitmann<br />
        Kastanienallee 24<br />
        21255 Tostedt<br />
        Deutschland
      </address>

      <h2 class="font-display mt-10 text-2xl font-medium">Kontakt</h2>
      <p class="mt-3 leading-relaxed">
        Telefon: <a href="tel:+491731839691" class="underline underline-offset-2"
          >+49&nbsp;173&nbsp;183&nbsp;9691</a
        ><br />
        E-Mail: <a href="mailto:me@sebastian-heitmann.dev" class="underline underline-offset-2"
          >me@sebastian-heitmann.dev</a
        >
      </p>

      <h2 class="font-display mt-10 text-2xl font-medium">
        Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV
      </h2>
      <p class="mt-3 leading-relaxed">Sebastian Heitmann, Anschrift wie oben.</p>

      <p class="text-ink-soft mt-6 leading-relaxed">
        Eine Umsatzsteuer-Identifikationsnummer nach § 27a UStG liegt nicht vor.
      </p>
      <p class="text-ink-soft mt-3 leading-relaxed">
        <span class="font-display text-ink italic">Marginalia</span> ist ein unabhängiges
        Open-Source-Projekt und steht in keiner Verbindung zu Google, NotebookLM oder Gemini.
      </p>
    </section>

    <section class="border-line mt-12 border-t pt-8">
      <h2 class="font-display text-2xl font-medium">Legal Notice (English translation)</h2>
      <p class="text-ink-soft mt-2 text-sm leading-relaxed">
        This translation is provided for convenience only; the German version above is
        authoritative.
      </p>

      <h3 class="mt-8 text-lg font-semibold">
        Information pursuant to § 5 DDG (German Digital Services Act)
      </h3>
      <address class="mt-3 leading-relaxed not-italic">
        Sebastian Heitmann<br />
        Kastanienallee 24<br />
        21255 Tostedt<br />
        Germany
      </address>

      <h3 class="mt-8 text-lg font-semibold">Contact</h3>
      <p class="mt-3 leading-relaxed">
        Phone: <a href="tel:+491731839691" class="underline underline-offset-2"
          >+49&nbsp;173&nbsp;183&nbsp;9691</a
        ><br />
        Email: <a href="mailto:me@sebastian-heitmann.dev" class="underline underline-offset-2"
          >me@sebastian-heitmann.dev</a
        >
      </p>

      <h3 class="mt-8 text-lg font-semibold">
        Responsible for content pursuant to § 18 (2) MStV (German State Media Treaty)
      </h3>
      <p class="mt-3 leading-relaxed">Sebastian Heitmann, address as above.</p>

      <p class="text-ink-soft mt-6 leading-relaxed">
        No VAT identification number pursuant to § 27a UStG has been issued.
      </p>
      <p class="text-ink-soft mt-3 leading-relaxed">
        <span class="font-display text-ink italic">Marginalia</span> is an independent open-source
        project. Not affiliated with Google, NotebookLM, or Gemini.
      </p>
    </section>
  </article>
</Base>
