---
import { getEntry } from "astro:content";
import DocPage from "../../layouts/DocPage.astro";

const entry = await getEntry("product", "scope");
if (!entry) throw new Error("product/scope.md not found");
---

<DocPage
  entry={entry}
  sourcePath="product/scope.md"
  title="Product scope — Marginalia Docs"
  description="The full feature catalogue of the Gemini Notebook clone, sorted into build phases."
/>
