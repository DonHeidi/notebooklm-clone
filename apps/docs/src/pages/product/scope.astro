---
import { getEntry } from "astro:content";
import DocPage from "../../layouts/DocPage.astro";

const entry = await getEntry("product", "scope");
if (!entry) throw new Error("product/scope.md not found");
---

<DocPage
  entry={entry}
  sourcePath="product/scope.md"
  title="Research catalog — Marginalia Docs"
  description="The research catalog of Gemini Notebook's functionality, with per-item implementation status."
/>
