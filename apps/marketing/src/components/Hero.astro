---
import GroundedDemo from "./GroundedDemo.astro";
---

<section class="mx-auto w-full max-w-6xl px-5 pt-14 pb-16 sm:px-8 sm:pt-20">
  <div class="max-w-3xl">
    <p class="eyebrow rise mb-5">An open-source AI research workspace</p>
    <h1 class="font-display rise rise-delay-1 text-5xl leading-[1.05] font-medium tracking-tight sm:text-6xl md:text-7xl">
      Research that <mark>shows its work</mark>.
    </h1>
    <p class="text-ink-soft rise rise-delay-2 mt-6 max-w-2xl text-lg leading-relaxed">
      Marginalia is a notebook for thinking with your own material. Ask questions in plain
      language; it answers only from the sources you've added — and every claim carries a citation
      you can click through to the exact passage.<a href="#fn-1" class="cite" aria-label="Footnote 1">1</a>
    </p>
    <div class="rise rise-delay-2 mt-8 flex flex-wrap gap-3">
      <a href="https://github.com/DonHeidi/notebooklm-clone" class="btn btn-primary">
        View on GitHub
      </a>
      <a href="#how-it-works" class="btn btn-ghost">How it works</a>
    </div>
  </div>

  <div class="mt-16">
    <GroundedDemo />
  </div>
</section>
