---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import AudioSection from "../components/AudioSection.astro";
import ScopeSection from "../components/ScopeSection.astro";
import CtaSection from "../components/CtaSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<Base
  title="Marginalia — research that shows its work"
  description="An open-source AI research workspace. Ask questions of your own sources and get answers with citations you can click through to the exact passage."
>
  <SiteHeader />
  <main id="main">
    <Hero />
    <HowItWorks />
    <AudioSection />
    <ScopeSection />
    <CtaSection />
  </main>
  <SiteFooter />
</Base>
