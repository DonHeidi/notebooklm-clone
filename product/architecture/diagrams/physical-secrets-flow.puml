@startuml physical-secrets-flow
' Secrets flow (SEC-6) — source of truth: .env.schema, the deploy
' workflows, infrastructure/main.tf
!theme plain
skinparam componentStyle rectangle

component ".env.schema (committed)\ndeclares every variable,\nmarks sensitivity" as Schema
component "Proton Pass\n(the store)" as PP
component ".env.local (untracked)\nresolved via pass-cli;\nall commands run through\nbunx varlock run --" as EnvLocal
component "GitHub Actions secrets\nset via gh secret set,\nnever echoed" as GH
component "Container runtime\nsecret_environment_variables\n(scaleway_container)" as Cont
component "Client bundle\nNEXT_PUBLIC_* build args —\npublishable, inlined at\nnext build" as Bundle

Schema ..> EnvLocal : schema validated\nby varlock
Schema ..> GH : declares the names
PP --> EnvLocal : developers
PP --> GH : CI / deploys
GH --> Bundle : build args
GH --> Cont : API tokens /\nterraform vars
@enduml
