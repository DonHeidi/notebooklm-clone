@startuml scenarios-use-cases
' The +1 scenarios — each verified end-to-end in the A3/A4 sessions
!theme plain
left to right direction

actor User

rectangle Marginalia {
  usecase "S1 — Add a PDF and watch\nit become chunks" as S1
  usecase "S2 — Ask a grounded question\nand follow a citation" as S2
  usecase "S3 — Sign up and log in" as S3
  usecase "S4 — Ask with zero\nsources selected" as S4
}

User --> S1
User --> S2
User --> S3
User --> S4

note right of S1
  process (ingestion pipeline),
  logical (chunks + offsets),
  physical (direct-to-Storage, embeddings API)
end note
note right of S2
  logical (retrieval, citations, grounding),
  process (chat request), physical (SSE)
end note
note right of S3
  process (proxy refresh), logical (ownerId),
  physical (the 307 smoke-test contract)
end note
note right of S4
  logical (zero-source branch),
  process (skipped retrieval)
end note
@enduml
