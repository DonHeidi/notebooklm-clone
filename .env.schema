# Root env schema, managed by varlock (https://varlock.dev).
# This file IS committed — it declares which variables exist, their types,
# and which are sensitive. Actual secret values live in Proton Pass and are
# resolved locally via pass-cli into an untracked .env.local, or injected in CI.
#
# Run anything that needs env through varlock, e.g.:
#   bunx varlock run -- bun run dev:webapp
#
# @defaultRequired=infer @defaultSensitive=true
# @envFlag=APP_ENV
# ---

# @required @sensitive=false @type=enum(development, preview, production)
APP_ENV=development

# --- Secrets provenance (Proton Pass, vault `marginalia`) --------------------
# Recovery path for .env.local on a fresh machine: every secret below maps to
# a pass-cli location (names only — values live exclusively in Proton Pass).
# Convention: field name = env var lowercased, underscores -> hyphens.
#
#   SUPABASE_DB_PASSWORD              item `supabase-marginalia` / field `supabase-db-password`
#   TF_VAR_supabase_url               item `supabase-marginalia` / field `tf-var-supabase-url`
#   TF_VAR_supabase_anon_key          item `supabase-marginalia` / field `tf-var-supabase-anon-key`
#   TF_VAR_supabase_service_role_key  item `supabase-marginalia` / field `tf-var-supabase-service-role-key`
#     ^ the three tf-var-supabase-* fields are legacy since B5 (Terraform
#       reads URL + keys from the Management API); vault fields may be pruned.
#   SUPABASE_ACCESS_TOKEN             NOT vaulted by policy (account-scoped):
#                                     system keyring only, written by
#                                     `supabase login` — see the token notes
#                                     below and infrastructure/AGENTS.md.
#   TF_VAR_database_url / DATABASE_URL (hosted)
#                                     item `supabase-marginalia` / field `tf-var-database-url`
#   SCW_ACCESS_KEY                    item `scaleway-api-key` / field `access-key-id`
#   SCW_SECRET_KEY                    item `scaleway-api-key` / field `secret-key`
#   SCW_DEFAULT_PROJECT_ID            item `scaleway-api-key` / field `scw-project-id`
#   AZURE_SPEECH_KEY                  item `Azure Speech — marginalia-speech (swedencentral)`
#                                     (login item: username = resource name `marginalia-speech`
#                                     — an identifier, not a credential; password = the API key.
#                                     Confirmed 2026-08-18)
#   SCW_GENERATIVE_APIS_KEY           SAME VALUE as `scaleway-api-key` / field `secret-key`
#                                     (one IAM secret key serves both env vars; rotating it
#                                     changes both — verified by hash 2026-08-18)
#
# Read with: pass-cli item view --vault-name marginalia --item-title <item> --field <field>
# Local-only values (supabase start demo JWTs, local DATABASE_URL) are not
# vaulted — see the A3 handover note.

# --- Supabase ---------------------------------------------------------------

# @required @sensitive=false @type=url
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable/anon key — safe to expose to the browser.
# @required @sensitive=false
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server only, never expose.
# @required
SUPABASE_SERVICE_ROLE_KEY=

# Pooled Postgres connection string (Supabase "transaction" pooler).
# @required @type=url
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Hosted Supabase (demo project, session B3; Terraform-managed since B5) --
# The hosted values live alongside the local ones above: locals stay in the
# NEXT_PUBLIC_*/DATABASE_URL variables for `bun run dev`. Since B5 Terraform
# reads the hosted URL + API keys itself (supabase_apikeys data source in
# infrastructure/supabase.tf) — only the DB password and pooler URL still
# flow in as TF_VARs.

# Supabase account access token for the CLI/Management API and the Terraform
# supabase provider (required at every plan/apply since B5). ACCOUNT-scoped —
# it controls the whole Supabase org. Handling per SEC-6: it lives ONLY in
# the system keyring (written by `supabase login`) and is injected
# ephemerally per command (see infrastructure/AGENTS.md); never store a
# value for it in .env.local, tfvars, Terraform state, or Proton Pass.
# @required=false
SUPABASE_ACCESS_TOKEN=

# Postgres password of the hosted project (set at `supabase projects create`).
# @required=false
SUPABASE_DB_PASSWORD=

# Same value under the name Terraform expects (supabase_project resource,
# B5). Consumed only if the project were ever (re)created — see
# ignore_changes in infrastructure/supabase.tf.
# @required=false
TF_VAR_supabase_db_password=${SUPABASE_DB_PASSWORD}

# Legacy since B5 — Terraform now sources URL + keys from the Management API
# (supabase_apikeys data source); these three are no longer read by any tool.
# Declarations kept so existing .env.local files stay schema-valid; safe to
# delete from .env.local and (later) from the vault.
# @required=false @sensitive=false @type=url
TF_VAR_supabase_url=

# Publishable by design (SEC-6): RLS enforces access, not key secrecy.
# @required=false @sensitive=false
TF_VAR_supabase_anon_key=

# @required=false
TF_VAR_supabase_service_role_key=

# Hosted transaction-pooler URL incl. DB password (port 6543, prepare:false).
# @required=false
TF_VAR_database_url=

# Same value as AZURE_SPEECH_KEY, under the name Terraform expects.
# (B5: now derived via varlock expansion — B3 declared it but .env.local
# never carried it, so applies needed a manual mapping.)
# @required=false
TF_VAR_azure_speech_key=${AZURE_SPEECH_KEY}

# --- Infrastructure (Terraform / Scaleway) ----------------------------------
# Terraform reads SCW_* from the environment; not needed to run the apps.

# @required=false
SCW_ACCESS_KEY=

# @required=false
SCW_SECRET_KEY=

# @required=false @sensitive=false
SCW_DEFAULT_PROJECT_ID=

# --- Scaleway Generative APIs (LLM/embeddings, feasibility D-4) --------------

# IAM secret key used as bearer token against https://api.scaleway.ai/v1.
# @required=false
SCW_GENERATIVE_APIS_KEY=

# Same key, exposed under the name Terraform expects for the container secret.
# @required=false
TF_VAR_generative_apis_key=

# Model override — Scaleway rotates model names on EOL cycles (D-4).
# @required=false @sensitive=false
SCW_GENERATIVE_APIS_MODEL=

# Project-scoped base URL (https://api.scaleway.ai/<project-id>/v1); needed
# when the IAM key's default project is not the target project.
# @required=false @sensitive=false @type=url
SCW_GENERATIVE_APIS_BASE_URL=

# Embedding model (feasibility D-4; default in code: qwen3-embedding-8b).
# Rotates on Scaleway EOL cycles like the chat model.
# @required=false @sensitive=false
SCW_GENERATIVE_APIS_EMBEDDING_MODEL=

# Project ID for Terraform (same value as SCW_DEFAULT_PROJECT_ID).
# @required=false @sensitive=false
TF_VAR_scw_project_id=
# --- TTS / Audio Overview (feasibility D-8, built in session D2) -------------

# Which TtsProvider adapter the webapp uses.
# @required=false @sensitive=false @type=enum(azure, elevenlabs, openai-compatible)
TTS_PROVIDER=azure

# Azure AI Speech resource key (D-8 primary provider).
# @required=false
AZURE_SPEECH_KEY=

# Azure region of the Speech resource (DragonHD voices need westeurope or
# swedencentral; standard neural voices also exist in germanywestcentral).
# @required=false @sensitive=false
AZURE_SPEECH_REGION=westeurope

# --- Testing (A7 / feasibility D-9) ------------------------------------------

# Overrides the Postgres the test factory provisions throwaway databases on.
# Defaults to the local Supabase stack (127.0.0.1:54322) when unset; CI points
# it at the pgvector service container.
# @required=false @sensitive=false @type=url
TEST_DATABASE_URL=
